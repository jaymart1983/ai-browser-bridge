{
  "manifest_version": 3,
  "name": "AI Browser Bridge",
  "version": "0.1.0",
  "description": "Pairs your browser with a local bridge so AI/MCP agents can drive it under rules you control. Loopback only - nothing leaves your device.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Browser Bridge",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116"
}
